#!@TERMUX_PREFIX@/bin/sh
if [ "${TERMUX_APP__AM_SOCKET_SERVER_ENABLED:-}" = true ] && [ -x "@TERMUX_PREFIX@/bin/termux-am" ]; then
    exec "@TERMUX_PREFIX@/bin/termux-am" stopservice -n com.termux/com.termux.api.KeepAliveService
fi
exec "@TERMUX_PREFIX@/bin/am" stopservice -n com.termux/com.termux.api.KeepAliveService
