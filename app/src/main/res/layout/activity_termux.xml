<com.termux.app.terminal.TermuxActivityRootView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_termux_root_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:background="?android:attr/colorBackground">

        <Button
            android:id="@+id/sessions_button"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:gravity="start|center_vertical"
            android:textAllCaps="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/action_open_sessions" />

        <Button
            android:id="@+id/toggle_keyboard_button"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="128dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <Button
            android:id="@+id/settings_button"
            style="?android:attr/borderlessButtonStyle"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="128dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/activity_termux_root_relative_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="3dp"
        android:layout_marginEnd="3dp">

        <com.termux.view.TerminalView
            android:id="@+id/terminal_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/terminal_extra_keys"
            android:defaultFocusHighlightEnabled="false"
            android:focusableInTouchMode="true"
            android:scrollbarThumbVertical="@drawable/terminal_scroll_shape"
            android:scrollbars="vertical" />

        <com.termux.shared.termux.extrakeys.ExtraKeysView
            android:id="@id/terminal_extra_keys"
            android:layout_width="match_parent"
            android:layout_height="37.5dp"
            android:layout_alignParentBottom="true"
            android:background="@color/black"
            android:visibility="gone" />
    </RelativeLayout>

    <View
        android:id="@+id/activity_termux_bottom_space_view"
        android:layout_width="match_parent"
        android:layout_height="1dp" />

</com.termux.app.terminal.TermuxActivityRootView>
